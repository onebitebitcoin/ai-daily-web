# docker compose가 읽는 파일. 복사해서 쓴다: cp .env.example .env
# (.env는 .gitignore 대상 — 실제 값은 커밋하지 않는다)

# --- Postgres ---
POSTGRES_USER=aidaily
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aidaily

# 백엔드가 붙는 DB. compose 내부에서 Postgres의 호스트명은 서비스명 `db`다.
# POSTGRES_* 값을 바꾸면 이 URL도 같이 바꿔야 한다.
DATABASE_URL=postgresql+psycopg2://aidaily:change-me@db:5432/aidaily

# --- 발행 API 키 ---
# POST /api/editions 인증용. 비워두면 항상 401로 닫힌다(fail closed).
ADMIN_API_KEY=

# --- 노출 포트 ---
# 호스트 nginx가 프록시할 포트. 서버의 다른 서비스(stack-health는 8018/8019 사용)와
# 겹치지 않게 배포 시점에 조정할 것(btc-daily-web 이 8020 을 쓴다).
# 127.0.0.1에만 바인딩된다(docker-compose.yml) — 외부에서 직접 접근할 수 없다.
WEB_PORT=8021

# --- 도메인 ---
# 아직 정하지 않았다. 로컬 개발만 하는 동안은 비워둔다 — 값이 필요한 곳은
# deploy/nginx/DOMAIN*.conf 두 파일과 scripts/daily-cron.sh 의 API 변수뿐이다.
# 정해지면 그 세 곳과 이 줄을 같이 채운다.
DOMAIN=
